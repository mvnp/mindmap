# Copie para .env e preencha. O arquivo .env NÃO vai para o git nem para a imagem Docker.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mindmap <no-reply@mindmap.local>
# endereço público do app, usado nos links dos e-mails
APP_URL=http://localhost:3000

# Assistente de IA: segredo (texto longo e aleatório) que criptografa as chaves de API dos usuários no banco.
# Sem ele, um segredo é gerado e guardado no próprio banco (protege menos). Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENC_SECRET=
# (somente para testes automatizados) endereço alternativo da API da Anthropic; deixe vazio
ANTHROPIC_BASE_URL=
